# JobLens backend configuration. Copy to backend/.env for local use.
ENV=development
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Host-machine defaults. Docker Compose overrides these with postgres/redis service names.
DATABASE_URL=postgresql+asyncpg://joblens:joblens_dev@localhost:5432/joblens
REDIS_URL=redis://localhost:6379/0

# Only explicitly enabled sources are scheduled. Simplify uses its own public
# feeds and never consumes JSearch/RapidAPI requests.
ENABLED_SCRAPER_SOURCES=simplify,jsearch
MAX_PAGES_PER_SOURCE=1
INGEST_BATCH_SIZE=250
SNAPSHOT_MIN_INTERVAL_HOURS=24
SCRAPE_LOCK_SECONDS=43200
AUTO_EXPIRE_STALE_JOBS=false
STALE_JOB_DAYS=14
PARALLEL_LISTING_WINDOW_DAYS=2
REPOST_MIN_GAP_DAYS=7
CANDIDATE_HISTORY_DAYS=365

# JSearch Pro plan protection.
# Put the rotated private key in backend/.env, NEVER in this example file.
# Default schedule: 7 role queries x 10 pages x 1 run/day x 31 days
# = at most 2,170 scheduled HTTP attempts. The app stops at 9,000 total
# attempts, preserving 1,000 of the 10,000 provider requests for retries,
# manual testing, and quota variance. Every retry also counts.
RAPIDAPI_KEY=
OPENWEBNINJA_API_KEY=
JSEARCH_PAGES_PER_QUERY=10
JSEARCH_SCHEDULE_EVERY_HOURS=24
JSEARCH_MONTHLY_REQUEST_LIMIT=10000
JSEARCH_REQUEST_RESERVE=1000
JSEARCH_QUERIES=software engineer,data analyst,data engineer,data scientist,machine learning engineer,product manager,security engineer
JSEARCH_COUNTRY=us
JSEARCH_LANGUAGE=en
JSEARCH_LOCATION=United States
JSEARCH_DATE_POSTED=month
JSEARCH_EXCLUDED_PUBLISHERS=simplify,simplifyjobs,simplify jobs
JSEARCH_EXCLUDED_DOMAINS=simplify.jobs
ALLOW_OVERLAPPING_JSEARCH_SOURCES=false
LINKEDIN_SCRAPER_MODE=jsearch

ZIPRECRUITER_API_KEY=
DICE_API_KEY=
JOBRIGHT_API_KEY=
JOBRIGHT_API_BASE_URL=https://api.jobright.ai/v1
SIMPLIFY_NEW_GRAD_FEED_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json
SIMPLIFY_INTERNSHIP_FEED_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2026-Internships/dev/.github/scripts/listings.json
SIMPLIFY_MAX_RECORDS=50000

# Geocoding is opt-in and operates on cached unique locations, never per posting.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=nominatim
GEOCODING_BATCH_SIZE=20
GEOCODING_DELAY_SECONDS=1.1
GEOCODING_RETRY_HOURS=24
GOOGLE_GEOCODING_API_KEY=
LOCATION_CLUSTER_RADIUS_MILES=40

GHOST_JOB_REPOST_WEIGHT=0.30
GHOST_JOB_DAYS_ACTIVE_WEIGHT=0.25
GHOST_JOB_APPLICANTS_WEIGHT=0.15
GHOST_JOB_SALARY_WEIGHT=0.10
GHOST_JOB_RATING_WEIGHT=0.10
GHOST_JOB_HISTORY_WEIGHT=0.10
SCORING_BATCH_SIZE=1000

EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.85
DESCRIPTION_SIMILARITY_THRESHOLD=0.70
SEMANTIC_TITLE_MATCHING_ENABLED=false
IDENTITY_CANDIDATE_LIMIT=100
DESCRIPTION_EMBEDDINGS_ENABLED=false
EMBEDDING_BATCH_SIZE=100
