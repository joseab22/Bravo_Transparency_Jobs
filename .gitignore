# EDITORS: VS CODE

# =============================================================================

.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

.history/
.vscode-test/

# =============================================================================

# EDITORS: JETBRAINS

# =============================================================================

.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# =============================================================================

# BUILD AND DISTRIBUTION ARTIFACTS

# =============================================================================

dist/
build/
target/

*.whl
*.tar.gz
*.zip

# Documentation ZIP files may be intentionally tracked.

!docs/*.zip

# =============================================================================

# SCRAPERS AND PLAYWRIGHT

# =============================================================================

playwright-report/
test-results/
.playwright/
browser_data/
cookies.json
session_data/

# Browser authentication and persistent context data

storage-state.json
auth-state.json
playwright/.auth/

# =============================================================================

# TEMPORARY AND MISCELLANEOUS FILES

# =============================================================================

*.swp
*.swo
*.tmp
*.temp

.temp/
.tmp/

# Temporary patch and merge files

*.orig
*.rej

# =============================================================================
# CLAUDE CODE LOCAL SETTINGS
# =============================================================================

# Machine-specific Claude permissions and sandbox rules
.claude/settings.local.json

# Personal Claude instructions that should not be shared
CLAUDE.local.md

# Project-level AI assistant instructions and generated audit trail --
# kept local only, never committed or pushed.
CLAUDE.md
docs/audit/
.neon

# Pinned deliberately so Render builds the backend against the same Python
# version as the local Dockerfile, not a personal pyenv preference.
!backend/.python-version
