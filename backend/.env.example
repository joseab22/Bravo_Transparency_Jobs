# =============================================================================
# JobLens — Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# --- App ---
ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_PREFIX=/api/v1
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://joblens:joblens_dev@localhost:5432/joblens

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SCRAPER SOURCES
# Enable the ones you have keys for. Disabled sources return empty results.
# =============================================================================

# --- Indeed + LinkedIn + Glassdoor (via JSearch on RapidAPI) ---
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 100 req/month | Basic: 500/month
RAPIDAPI_KEY=

# --- LinkedIn ---
# Mode: "jsearch" (uses RAPIDAPI_KEY above) | "playwright" (headless, no key)
LINKEDIN_SCRAPER_MODE=jsearch
# If using LinkedIn official API (requires partner approval):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Glassdoor ---
# Partner API (requires approval at glassdoor.com/developer):
GLASSDOOR_PARTNER_ID=
GLASSDOOR_PARTNER_KEY=

# --- ZipRecruiter ---
# Publisher API — free, apply at ziprecruiter.com/publishers
ZIPRECRUITER_API_KEY=

# --- Dice ---
# No key required for basic search. Optional for higher rate limits.
DICE_API_KEY=

# --- Monster ---
# Via RapidAPI monster endpoint (uses RAPIDAPI_KEY above)
# No additional key needed if RAPIDAPI_KEY is set.
MONSTER_API_KEY=

# --- Jobright ---
# Request access at https://jobright.ai
JOBRIGHT_API_KEY=
JOBRIGHT_API_BASE_URL=https://api.jobright.ai/v1

# --- Simplify ---
# No key required — uses public GitHub JSON feeds by default
# Optional: set if/when Simplify opens a public API
SIMPLIFY_API_KEY=

# =============================================================================
# SCRAPING BEHAVIOR
# =============================================================================
SCRAPE_INTERVAL_HOURS=6
MAX_PAGES_PER_SOURCE=10

# =============================================================================
# LOCATION
# =============================================================================
# Optional: Google Geocoding API for higher accuracy than Nominatim (free)
GOOGLE_GEOCODING_API_KEY=
LOCATION_CLUSTER_RADIUS_MILES=40

# =============================================================================
# SCORING WEIGHTS (must sum to 1.0)
# =============================================================================
GHOST_JOB_REPOST_WEIGHT=0.30
GHOST_JOB_DAYS_ACTIVE_WEIGHT=0.25
GHOST_JOB_APPLICANTS_WEIGHT=0.15
GHOST_JOB_SALARY_WEIGHT=0.10
GHOST_JOB_RATING_WEIGHT=0.10
GHOST_JOB_HISTORY_WEIGHT=0.10

# =============================================================================
# EMBEDDINGS / NLP
# =============================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.85
# HuggingFace cache dir (default: ~/.cache/huggingface)
# TRANSFORMERS_CACHE=/tmp/hf_cache
