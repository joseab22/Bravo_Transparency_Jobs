# Used only for docker-compose.prod.yml interpolation.
# Copy to an untracked file and replace all placeholder values.
POSTGRES_USER=joblens
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=joblens
PUBLIC_PORT=8080
CELERY_CONCURRENCY=2
# Deployed origin (no trailing slash). Baked into the frontend build at
# image-build time -- used for canonical tags, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
