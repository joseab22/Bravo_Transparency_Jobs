# =============================================================================

# JobLens Production .gitignore

# Python + FastAPI + PostgreSQL + Celery + Redis + Next.js + Docker

# GitHub Desktop: choose the Python template, then replace it with this file.

# =============================================================================

# =============================================================================

# ENVIRONMENT AND SECRETS

# Never commit these files.

# =============================================================================

.env
.env.*
!.env.example
!.env.production.example

*.pem
*.key
*.p12
*.pfx

secrets/
.secrets/

# Local PostgreSQL authentication files

.pgpass
pgpass.conf

# =============================================================================

# PYTHON

# =============================================================================

**pycache**/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

*.egg
*.egg-info/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# NOTE: a bare "lib/" rule used to live here (standard Python venv
# boilerplate). Removed: gitignore patterns with no leading "/" match at
# ANY depth, so it was silently swallowing frontend/src/lib/ -- the actual
# frontend source directory -- not just a Python virtualenv's lib folder.
# venv/ below already covers the real Python case this was meant for.
lib64/
MANIFEST

# Virtual environments

venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
pythonenv*

# Testing and coverage

.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml
pytest-report.xml
test-results/

# Type checking

.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Linting

.ruff_cache/

# Jupyter

.ipynb_checkpoints/

# Notebooks are intentionally allowed to be committed.

# Do not add *.ipynb here unless that policy changes.

# =============================================================================

# FASTAPI AND UVICORN

# =============================================================================

*.pid
*.sock
uvicorn.log

# =============================================================================

# CELERY

# =============================================================================

celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid
celery-worker.log
celery-beat.log
celeryd.log

# =============================================================================

# ALEMBIC

# Migration source files must remain tracked.

# =============================================================================

migrations/**pycache**/
backend/migrations/**pycache**/
backend/alembic/**pycache**/

# =============================================================================

# HUGGING FACE, SENTENCE TRANSFORMERS, AND EMBEDDINGS

# Local model caches are large and should not be committed.

# =============================================================================

.cache/
huggingface/
hf_cache/
transformers_cache/
TRANSFORMERS_CACHE/
model_cache/
embeddings_cache/
sentence_transformers_cache/

*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.pkl
*.pickle

# =============================================================================

# DATABASE

# =============================================================================

# SQLite databases and support files

*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

# Local PostgreSQL bind-mount directories

postgres_data/
pgdata/
.postgres-data/
postgres-data/
database_data/
db_data/

# Database dumps and backups

*.sql.gz
*.dump
*.backup
*.bak

dumps/
backups/
database_backups/
db_backups/

# Do not ignore all *.sql files globally.

# Alembic migrations, schema definitions, and seed SQL may need to be tracked.

# =============================================================================

# JOB LISTING VERIFICATION

# Generated reports, logs, backups, and manual-review files.

# =============================================================================

backend/availability_reports/
availability_reports/

# Covers listing-verification artifacts stored elsewhere by mistake

listing_verification_*.jsonl
listing_verification_**summary.json
full_listing_cleanup.log
full_listing_cleanup.pid
new_dry_run.log
new_dry_run.pid
inactive_for_manual_review.txt
inactive_manual_review.html
pre_cleanup**.sql

# =============================================================================

# REDIS

# =============================================================================

redis_data/
dump.rdb
appendonly.aof
redis.log

# Redis append-only storage directories

appendonlydir/

# =============================================================================

# DOCKER

# =============================================================================

.docker/
docker-volumes/
*.tar

# Local Docker overrides may contain machine-specific settings or secrets.

docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Example override files may still be committed.

!docker-compose.override.example.yml
!docker-compose.override.example.yaml
!compose.override.example.yml
!compose.override.example.yaml

# =============================================================================

# NODE AND NEXT.JS

# =============================================================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.pnpm-store/
package-lock.json.bak

.next/
out/
.vercel/
.netlify/
.turbo/

*.tsbuildinfo
next-env.d.ts

# =============================================================================

# LOGS

# =============================================================================

logs/
log/
scraper_logs/

*.log
*.log.*

